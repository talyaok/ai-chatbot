# Anthropic (Claude chat / RAG / multimodal)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024

# OpenAI (embeddings only — never expose to the browser)
OPENAI_API_KEY=your_openai_api_key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/finlatics_chatbot?schema=public


# NextAuth
NEXTAUTH_SECRET=generate_a_long_random_string
NEXTAUTH_URL=http://localhost:3000

# Optional: comma-separated origins if you ever call APIs cross-origin
ALLOWED_ORIGINS=http://localhost:3000
